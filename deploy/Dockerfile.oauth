FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HOME=/home/mcp
WORKDIR /app
COPY deploy/requirements-oauth.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt && useradd --create-home --uid 10001 mcp
COPY --chown=mcp:mcp huatai_oauth /app/huatai_oauth
USER mcp
EXPOSE 8080
CMD ["python", "-m", "huatai_oauth.server"]
